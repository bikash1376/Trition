# Get these at https://trello.com/power-ups/admin -> New -> API Key
TRELLO_API_KEY=
TRELLO_API_SECRET=

# Base URL this app is served from (used to build the Trello OAuth return_url)
NEXT_PUBLIC_APP_URL=http://localhost:3211

# Databuddy analytics (https://www.databuddy.cc) — optional, leave blank to disable
NEXT_PUBLIC_DATABUDDY_CLIENT_ID=
