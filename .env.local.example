# Get these at https://trello.com/power-ups/admin -> New -> API Key
TRELLO_API_KEY=
TRELLO_API_SECRET=

# Base URL this app is served from (used to build the Trello OAuth return_url)
NEXT_PUBLIC_APP_URL=http://localhost:3211

# Databuddy analytics (https://www.databuddy.cc) — optional, leave blank to disable
NEXT_PUBLIC_DATABUDDY_CLIENT_ID=

# "Try now" demo login on the login page — optional, leave blank to hide the button.
# A Trello token for a throwaway account you control, with no client secret needed
# (same manual token-mint flow as below). Never use a real account's token here —
# this token is shared by every demo visitor and its boards get swept periodically.
# Get it by visiting (replace {key} with TRELLO_API_KEY above), logged into the
# throwaway account: https://trello.com/1/authorize?expiration=never&scope=read,write&response_type=token&key={key}&name=Trition%20Demo
DEMO_TRELLO_TOKEN=
